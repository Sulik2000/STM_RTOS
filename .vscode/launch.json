{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug bootloader (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/out/bootloader/Nucleo-F411RE/Debug/bootloader.elf",
            "device": "STM32F411RE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "arm-none-eabi-gdb",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}