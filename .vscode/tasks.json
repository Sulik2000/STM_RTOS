{
    "tasks": [
        {
            "label": "Launch bootloader with OpenOCD(ST-Link)",
            "type": "shell",
            "command": [
                "openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"program out/bootloader/Nucleo-F411RE/Debug/bootloader.elf verify reset exit\""
            ]
        },
        {
            "label": "CMSIS Load+Run",
            "problemMatcher": [],
            "type": "arm-debugger.flash",
            "connectionAddress": "*",
            "connectionType": "ST-Link",
            "programs": [
                "${command:arm-debugger.getApplicationFiles}"
            ],
            "cmsisPack": "${command:cmsis-csolution.getDfpName}",
            "deviceName": "${command:cmsis-csolution.getDeviceName}",
            "processorName": "${command:cmsis-csolution.getProcessorName}",
            "workspaceFolder": "${workspaceFolder}/",
            "debugClockSpeed": "auto",
            "debugPortMode": "JTAG"
        }
    ],
    "version": "2.0.0"
}